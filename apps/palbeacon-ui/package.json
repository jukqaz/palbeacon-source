{
  "name": "@palbeacon/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare-data": "node scripts/sync-exact-data.mjs",
    "dev": "pnpm prepare-data && vite dev",
    "build": "pnpm prepare-data && vite build && node scripts/verify-web-release.mjs",
    "verify:web": "node scripts/verify-web-release.mjs",
    "preview": "vite preview",
    "check": "pnpm prepare-data && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "pnpm prepare-data && oxlint .",
    "lint:fix": "pnpm prepare-data && oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "pnpm prepare-data && vitest run",
    "test:coverage": "pnpm prepare-data && vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && node scripts/run-e2e.mjs",
    "test:usability": "pnpm build && node scripts/run-e2e.mjs e2e/usability.spec.ts",
    "test:pwa": "pnpm build && node scripts/run-pwa-e2e.mjs",
    "capture:flow-qa": "node scripts/capture-flow-qa.mjs"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "4.2.3",
    "@hugeicons/svelte": "1.1.4",
    "@panzoom/panzoom": "4.6.2",
    "@tanstack/svelte-virtual": "3.13.35",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-autostart": "2.5.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "bits-ui": "2.18.1",
    "svelte-sonner": "1.2.1",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.2",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.11",
    "fast-check": "4.9.0",
    "jsdom": "30.0.1",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "svelte": "5.56.9",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.11"
  }
}
